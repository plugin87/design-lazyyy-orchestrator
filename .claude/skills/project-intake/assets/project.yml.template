# project.yml — ความจำร่วมของทุกบทบาทในสายงาน
#
# ทุก skill อ่านไฟล์นี้ก่อนเริ่มงาน และเขียนกลับเมื่อได้คำตอบใหม่
# กติกา — ไม่รู้ให้เขียน  TBD — ต้องการ [คน/ข้อมูล]  ห้ามเว้นว่าง ห้ามเดา
# ตัวเลขที่เดา ให้บันทึกไว้ใต้ assumptions ด้วย

meta:
  name:                       # ชื่อโครงการ
  code:                       # รหัสสามตัวอักษรพิมพ์ใหญ่ ใช้แทน XXX ในรหัสเอกสาร
  owner:                      # ชื่อนักเรียนเจ้าของโครงการ
  mode: solo                  # solo = คนเดียวเล่นครบทุกบทบาท
  started:                    # YYYY-MM-DD
  language: th                # ภาษาของเอกสารส่งมอบ

# ระยะปัจจุบันของโครงการ — มีเพียง /gate เท่านั้นที่เลื่อนค่านี้
# intake → product → analysis → design → build → review → quality → release
stage: intake

problem:
  statement:                  # ปัญหาในหนึ่งประโยค เขียนเป็นปัญหา ไม่ใช่วิธีแก้
  users:                      # ใครเจอปัญหานี้ ระบุให้เจาะจงกว่าคำว่า "ผู้ใช้"
  frequency:                  # เจอบ่อยแค่ไหน
  today_workaround:           # วันนี้เขาทำยังไงเมื่อยังไม่มีของชิ้นนี้
  cost:                       # ไม่แก้แล้วเสียอะไร

outcome:
  metric:                     # วัดด้วยอะไร ต้องเป็นตัวเลขที่ลดลงได้ ไม่ใช่ "engagement เพิ่ม"
  baseline:                   # วันนี้ค่าเท่าไหร่
  target:                     # อยากให้เป็นเท่าไหร่
  measured_by:                # ใครวัด วัดเมื่อไหร่

scope:
  in: []                      # อยู่ในขอบเขตรอบนี้
  out: []                     # ตัดออกอย่างชัดเจน — ต้องมี ไม่ใช่เว้นว่าง
  constraints: []             # เดดไลน์ แพลตฟอร์ม กฎหมาย ข้อมูลเดิม แบรนด์
  approver:                   # ใครเซ็นอนุมัติขอบเขต

delivery:
  people:                     # มีใครทำบ้าง กี่คน
  days_available:             # วันทำงานจริงที่มี หักลาและประชุมแล้ว
  iteration_length:           # รอบทำงานยาวเท่าไหร่
  hard_deadline:              # เดดไลน์ที่ขยับไม่ได้ ถ้าไม่มีให้เขียนว่าไม่มี

technical:
  data_location:              # ข้อมูลอยู่ที่ไหน เครื่องผู้ใช้ เซิร์ฟเวอร์ หรือทั้งสอง
  offline:                    # ต้องใช้งานตอนไม่มีเน็ตไหม
  integrations: []            # ต่อกับระบบอะไรบ้าง
  stack:                      # ภาษาและเฟรมเวิร์ก
  existing_code:              # มีโค้ดเดิมไหม อยู่ที่ไหน

design:
  brand:                      # โทน สี ตัวอักษร ถ้ามีคู่มือแบรนด์ให้ชี้ที่อยู่
  devices: []                 # อุปกรณ์เป้าหมาย
  existing_system:            # มี design system เดิมไหม หรือเริ่มจากศูนย์

build:
  definition_of_done: []      # เกณฑ์ว่างานหนึ่งชิ้นเสร็จ — ดู skill developer
  branch_convention:          # ตั้งชื่อ branch ยังไง

quality:
  wcag: AA                    # ระดับที่ยึด
  browsers: []                # เบราว์เซอร์และรุ่นที่รองรับ
  design_reference:           # ไฟล์แบบที่ใช้เทียบ ถ้าไม่มีให้ระบุว่าไม่มี

release:
  target:                     # ปล่อยขึ้นที่ไหน
  approver:                   # ใครกดปล่อย
  rollback:                   # ถอยกลับยังไง ใช้เวลาเท่าไหร่

# ผลการตรวจประตู — เขียนโดย /gate เท่านั้น
gates: []
# - id: G1
#   name: Definition of Ready
#   checked: 2026-08-14
#   result: fail            # pass | fail
#   missing:
#     - ยังไม่มี acceptance criteria สำหรับเส้นทางที่ผิดพลาด

# ช่องที่ยังไม่มีคำตอบ — ทุกช่องที่เป็น TBD ต้องมีรายการที่นี่
open_questions: []
# - field: outcome.metric
#   note: TBD — ต้องการตัวเลขฐานจากผู้สอน
#   raised: 2026-08-14

# ตัวเลขหรือข้อเท็จจริงที่เป็นการเดา ไม่ใช่ของที่รู้จริง
assumptions: []
